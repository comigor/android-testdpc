            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name=".feedback.AppStatesService"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.enterprise.feedback.action.APP_STATES" />
