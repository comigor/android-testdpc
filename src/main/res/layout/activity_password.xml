<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/passwordTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shadow_unlock"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/passwordStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/etCurrentPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/shadow_password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:imeOptions="actionDone|flagNoPersonalizedLearning"
            android:saveEnabled="false"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/shadow_new_password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:imeOptions="actionNext|flagNoPersonalizedLearning"
            android:saveEnabled="false"
            android:importantForAutofill="no"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/shadow_confirm_password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:imeOptions="actionDone|flagNoPersonalizedLearning"
            android:saveEnabled="false"
            android:importantForAutofill="no"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/shadow_unlock" />

        <Button
            android:id="@+id/btnUseFingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shadow_use_biometric"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shadow_change_password"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
